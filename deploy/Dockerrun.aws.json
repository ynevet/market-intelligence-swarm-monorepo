{
  "AWSEBDockerrunVersion": 2,
  "containerDefinitions": [
    {
      "name": "server",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/mis-server:latest",
      "essential": true,
      "memory": 512,
      "portMappings": [
        { "containerPort": 5000 }
      ],
      "environment": [
        { "name": "OPENAI_API_KEY", "value": "REPLACE_ME" },
        { "name": "TAVILY_API_KEY", "value": "REPLACE_ME" },
        { "name": "MONGO_URI", "value": "REPLACE_ME" }
      ],
      "command": [
        "gunicorn",
        "--bind",
        "0.0.0.0:5000",
        "--worker-class",
        "gthread",
        "--threads",
        "4",
        "--timeout",
        "0",
        "application:application"
      ]
    },
    {
      "name": "client",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/mis-client:latest",
      "essential": true,
      "memory": 256,
      "portMappings": [
        { "containerPort": 4173 }
      ],
      "links": [
        "server"
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "VITE_SERVER_URL", "value": "http://server:5000" }
      ],
      "command": [
        "serve",
        "-s",
        "dist",
        "-l",
        "4173"
      ]
    }
  ]
}

